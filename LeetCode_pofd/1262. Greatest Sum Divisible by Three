class Solution {
    int calculate(int ind,int rem,int size,vector<int>&nums,vector<vector<int>>&dp) {
        if(ind==size) {
            return (rem==0)?0:INT_MIN/2;
        }
        if(dp[ind][rem]!=INT_MIN) return dp[ind][rem];
        int left = nums[ind] + calculate(ind+1,(rem+nums[ind])%3,size,nums,dp);
        int right = calculate(ind+1,rem,size,nums,dp);
        return dp[ind][rem] = max(left,right);
    }
public:
    int maxSumDivThree(vector<int>& nums) {
        vector<vector<int>>dp(nums.size(),vector<int>(3,INT_MIN));
        int ans = calculate(0,0,nums.size(),nums,dp);
        return (ans<0)?0:ans;
    }
};